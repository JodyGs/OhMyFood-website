:root {
  --primary-color: #9356DC;
  --secondary-color: #FF79DA;
  --tertiary-color: #99E2D0;
  --green: #008766;
  --light-blue: #89C8FA;
  --dark-blue: #003A68;
  --black: #101010;
  --grey: #353535;
  --light-grey: #eaeaea;
  --lighter-grey: #F6F6F6;
  --white: #ffffff;
}

/* Reset & Base */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    text-decoration: none;
    list-style: none;
    color: var(--black);
}

html, body {
    font-family: "Roboto", sans-serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-style: normal;
    font-variation-settings: "wdth" 100;
    color: var(--black);
}

.logo {
    font-family: "Shrikhand", serif;
    font-weight: 400;
    font-style: normal;
}

.title {
    font-size: 24px;
    font-weight: 700;
    margin: 16px 0;
}

a {
    cursor: pointer;
}

/* Buttons */
.btn {
    color: var(--white);
    font-size: 16px;
    border-radius: 25px;
    border: none;
    padding: 13px 18px;
    background: linear-gradient(-4deg, var(--primary-color) -11.44%, var(--secondary-color) 123.93%);
    margin: auto;
    cursor: pointer;
    transition: opacity 0.3s ease;

    &:hover {
        opacity: 0.9;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }
}

/* Like Button */
.btn-like {
    i {
        font-size: 1.5625rem;
        color: #101010;
        font-weight: 400;
        transition: 
            background-image 0.3s ease,
            font-weight 0.3s ease,
            -webkit-text-fill-color 0.8s ease;
    }
}

.checkbox-like {
    display: none;

    &:checked + i {
        font-weight: 700;
        background-image: linear-gradient(180deg, var(--secondary-color), var(--primary-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
    }
}

/* Loader */
.loader {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 10;
    background-color: #fff;
    animation: fadeout 2s ease forwards;
    animation-delay: 2s;

    .container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 142px;
        height: 40px;
        background: #fff;
        filter: contrast(20);

        .dot {
            position: absolute;
            width: 16px;
            height: 16px;
            top: 12px;
            left: 15px;
            filter: blur(4px);
            background: var(--primary-color);
            border-radius: 50%;
            animation: point 2.8s infinite;
        }

        .dots {
            margin-top: 12px;
            margin-left: 31px;
            animation: points 2.8s infinite;

            span {
                display: block;
                float: left;
                width: 16px;
                height: 16px;
                margin-left: 16px;
                filter: blur(4px);
                background: var(--primary-color);
                border-radius: 50%;
            }
        }
    }
}

@keyframes point {
    50% { transform: translateX(96px); }
}

@keyframes points {
    50% { transform: translateX(-31px); }
}

@keyframes fadeout {
    from { opacity: 1; }
    to { opacity: 0; visibility: hidden; }
}

/* HEADER */
header {
    background-color: white;
    text-align: center;
    padding-bottom: 6px;

    .logo {
        font-size: 30px;
        background-color: white;
    }

    .shadow {
        box-shadow: 0px 2px 4px 0px #00000026;
    }

    .top-bar {
        background-color: var(--light-grey);
        padding-bottom: 4px;
    }

    form {
        width: 100%;
        background-color: var(--light-grey);
        padding: 12px 0 16px;
        box-shadow: 0px 4px 4px 0px #00000040;

        input[type="search"] {
            max-width: 190px;
            background-image: url('data:image/svg+xml;utf8,<svg fill="black" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M8 0a5.53 5.53 0 0 0-5.5 5.5c0 3.04 5.5 10.5 5.5 10.5s5.5-7.46 5.5-10.5A5.53 5.53 0 0 0 8 0Zm0 7.5A2 2 0 1 1 8 3a2 2 0 0 1 0 4.5Z"/></svg>');
            background-repeat: no-repeat;
            background-size: 12px 16px;
            background-position: 10px center;
            padding-left: 36px;
            font-size: 16px;
            font-weight: 500;
            border: none;
            background-color: var(--light-grey);
            outline: none;
            width: 100%;

            &::placeholder {
                color: var(--black);
                opacity: 1;
            }

            &::-webkit-search-cancel-button {
                display: none;
            }
        }
    }
}

/* Restaurant Header */
.header {
    position: relative;
    z-index: 1;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;

    .navbar {
        margin-right: auto;
        padding: 0 12px;

        a {
            display: inline-block;
            font-size: 1.125rem;
            transform: scale(1);
            transition: transform 0.3s ease;

            &:hover {
                transform: scale(1.1);
            }
        }

        ~ h1 {
            margin-right: auto;
        }
    }
}

/* Hero Banner */
.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
    background-color: var(--lighter-grey);
    text-align: center;
    gap: 12px;
    
    h2 {
        font-size: 24px;
        font-weight: 700;
        max-width: 275px;
    }

    p {
        font-size: 18px;
        font-weight: 300;
        max-width: 315px;
        margin-bottom: 16px;
    }
}

/* Sections */
#fonctionnement, #restaurants {
    padding: 48px 20px 64px;
}

#restaurants {
    background-color: var(--lighter-grey);
}

/* Steps */
.steps__list {
    padding: 0 12px;
}

.step {
    background: #F6F6F6;
    padding: 1.5625rem 0.625rem;
    margin-bottom: 1.25rem;
    margin-left: 0.8125rem;
    border-radius: 1.5rem;
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;

    &:hover {
        background-color: #F5EDFF;

        .step__icon {
            color: var(--primary-color);
        }
    }

    &__icon {
        margin: 0 1.25rem 0 1.625rem;
        font-size: 1.25rem;
        color: #7E7E7E;
    }

    &__title {
        font-weight: 900;
    }

    &__number {
        background: var(--primary-color);
        color: var(--white);
        width: 1.625rem;
        height: 1.625rem;
        line-height: 1.625rem;
        border-radius: 50%;
        font-size: 0.8125rem;
        text-align: center;
        position: absolute;
        left: -0.8125rem;
    }
}

/* Cards */
.card {
    position: relative;
    border-radius: 1rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    transition: box-shadow 0.3s ease;

    &:hover {
        box-shadow: 0 15px 20px rgba(0, 0, 0, 0.2);
    }

    &__img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
    }

    &__body {
        padding: 1rem;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
    }

    &__title {
        font-size: 1.125rem;
        font-weight: 900;
        margin-bottom: 0.3125rem;
    }

    &__city {
        font-weight: 300;
        text-transform: capitalize;
    }

    &__status {
        padding: 0.5rem 0.75rem;
        background-color: var(--tertiary-color);
        color: var(--green);
        font-size: 0.875rem;
        position: absolute;
        top: 15px;
        right: 15px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        border-radius: 2px;
    }
}

/* Menu Pages */
.menu {
    padding: 0;

    &__banner {
        width: 100%;
        height: 300px;
        object-fit: cover;
        position: relative;
        z-index: 1;
    }

    &__content {
        background-color: var(--lighter-grey);
        border-top-left-radius: 2.5rem;
        border-top-right-radius: 2.5rem;
        margin-top: -4rem;
        position: relative;
        z-index: 2;
        padding: 20px;
    }

    &__info {
        margin-bottom: 2.5rem;
        padding: 12px 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: nowrap;
    }

    &__title {
        font-family: "Shrikhand", cursive;
        font-weight: normal;
        font-size: 1.75rem;
        margin-bottom: 0;
    }

    &__plates {
        margin-bottom: 3rem;

        .plates__list {
            padding: 0 8px;
        }
    }
}

/* Plates */
@keyframes plate-slide-in {
    0% {
        transform: translateX(-20px);
        opacity: 0;
    }
    100% {
        transform: translateX(0);
        opacity: 1;
    }
}

.plate {
    padding: 0.75rem;
    background: var(--white);
    border-radius: 1rem;
    margin-bottom: 1rem;
    animation: plate-slide-in 0.6s ease both;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: inherit;
    justify-content: space-between;
    opacity: 0;
    cursor: pointer;
    transition: box-shadow 0.3s ease;

    &:hover {
        box-shadow: 0 15px 20px rgba(0, 0, 0, 0.2);

        .plate__confirmation {
            margin-right: -0.75rem;

            i {
                transform: rotate(360deg);
            }
        }
    }

    &__info {
        white-space: nowrap;
        overflow: hidden;
        flex: 1;
    }

    &__title, &__composition {
        text-overflow: ellipsis;
        overflow: hidden;
    }

    &__title {
        font-weight: 900;
        font-size: 1.125rem;
        margin-bottom: 0.3125rem;
    }

    &__composition {
        font-weight: 300;
        font-size: 0.9375rem;
    }

    &__price {
        align-self: flex-end;
        margin-left: 0.625rem;
    }

    &__confirmation {
        background-color: var(--tertiary-color);
        color: var(--white);
        font-size: 1.25rem;
        border-top-right-radius: 1rem;
        border-bottom-right-radius: 1rem;
        width: 3.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: -0.75rem -4.5rem -0.75rem 1rem;
        transition: margin-right 750ms ease;

        i {
            transform: rotate(0);
            transition: transform 750ms ease;
            color: var(--white);
        }
    }
}

/* Plate Animation Delays */
.plates__list .plate {
    &:nth-child(1) { animation-delay: 0.1s; }
    &:nth-child(2) { animation-delay: 0.2s; }
    &:nth-child(3) { animation-delay: 0.3s; }
    &:nth-child(4) { animation-delay: 0.4s; }
    &:nth-child(5) { animation-delay: 0.5s; }
    &:nth-child(6) { animation-delay: 0.6s; }
    &:nth-child(7) { animation-delay: 0.7s; }
    &:nth-child(8) { animation-delay: 0.8s; }
    &:nth-child(9) { animation-delay: 0.9s; }
    &:nth-child(10) { animation-delay: 1s; }
}

.underline-title {
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    font-weight: 300;
    font-size: 1rem;
    margin-left: 8px;

    &:after {
        background: var(--tertiary-color);
        bottom: -0.3125rem;
        content: "";
        display: block;
        height: 0.1875rem;
        position: relative;
        width: 2.5rem;
    }
}

.btn-plates {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0;
}

/* Footer */
footer {
    background-color: var(--grey);
    color: white;
    padding: 20px;

    .logo {
        font-size: 18px;
        margin-bottom: 12px;
        color: white;
    }

    ul {
        li {
            margin-bottom: 7px;
            color: var(--white);

            a {
                color: inherit;
                display: flex;
                align-items: center;
                gap: 11px;

                svg {
                    flex-shrink: 0;
                }
            }

            &:nth-child(1), &:nth-child(2) {
                font-weight: 500;
            }
        }
    }
}

/* RESPONSIVE */

/* Tablet */
@media screen and (min-width: 768px) {
    /* Header */
    header {
        padding-bottom: 0;

        .shadow {
            box-shadow: none;
        }

        form {
            box-shadow: none;
        }
    }

    /* Hero */
    .hero {
        h2 {
            font-size: 40px;
            max-width: none;
        }

        p {
            font-size: 18px;
            font-weight: 300;
            max-width: none;
            margin-bottom: 16px;
        }
    }

    /* Sections */
    #fonctionnement, #restaurants {
        padding: 50px;
    }

    /* Steps */
    .steps__list {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        justify-content: center;
        padding: 0;
    }

    .step {
        flex: 0 0 45%;
        margin: 0;
        white-space: nowrap;
    }

    /* Cards */
    .cards__list {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        gap: 50px;

        a {
            width: 48%;
            max-width: 490px;
        }
    }

    /* Menu */
    .menu__content {
        padding: 32px 40px;
    }

    .menu__info {
        justify-content: center;
        gap: 24px;
    }

    .menu__plates {
        display: flex;
        flex-direction: column;
        gap: 2rem;

        .plates__list {
            padding: 0;
            display: flex;
            flex-direction: column;
            flex: 1;
        }
    }

    .plate {
        margin-bottom: 1rem;
    }

    /* Footer */
    footer {
        display: flex;
        flex-direction: row-reverse;
        justify-content: space-between;
        gap: 20px;
        align-items: center;
        padding-top: 70px;

        nav {
            width: 100%;
        }

        ul {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }
    }
}

/* Desktop */
@media screen and (min-width: 1024px) {
    /* Sections */
    #fonctionnement, #restaurants {
        padding: 50px 180px;
    }

    /* Steps */
    .steps__list {
        gap: 36px;
        flex-wrap: nowrap;
    }

    .step {
        flex: 1;
    }

    /* Cards */
    .cards__list {
        gap: 100px;

        a {
            width: 490px;
            max-width: 490px;
        }
    }

    /* Menu */
    .menu__content {
        max-width: 1200px;
        margin: -4rem auto 0;
        padding: 51px 210px;
    }

    .menu__info {
        justify-content: center;
        gap: 24px;
    }

    .menu__plates {
        display: flex;
        flex-direction: column;
        gap: 2rem;

        .plates__list {
            display: flex;
            flex-direction: column;
            flex: 1;
        }
    }
}